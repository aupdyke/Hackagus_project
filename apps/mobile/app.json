{
  "expo": {
    "name": "Falcon Travel",
    "slug": "falcon-travel",
    "scheme": "falcontravel",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "edu.bgsu.hackathon.falcontravel",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "edu.bgsu.hackathon.falcontravel"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#FE5000"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#501D08"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/3eb978c3-6967-430a-aebd-c3f79230db96"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "apiUrl": "https://falcon-travel-api.onrender.com",
      "eas": {
        "projectId": "3eb978c3-6967-430a-aebd-c3f79230db96"
      }
    },
    "icon": "./assets/icon.png",
    "owner": "carter5556"
  }
}
