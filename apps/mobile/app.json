{
  "expo": {
    "name": "Falcon Travel",
    "slug": "falcon-travel",
    "scheme": "falcontravel",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "edu.bgsu.hackathon.falcontravel",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "edu.bgsu.hackathon.falcontravel"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#FE5000"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "router": {}
    }
  }
}
