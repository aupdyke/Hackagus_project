{
  "name": "@falcon/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "release:check": "node ../../scripts/check-release.mjs",
    "ios:build": "node ../../scripts/check-release.mjs && eas build -p ios --profile production --auto-submit",
    "ios:submit": "eas submit -p ios --profile production --latest",
    "ios:update": "node ../../scripts/check-release.mjs && eas update --channel production --message"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@falcon/shared": "*",
    "@tanstack/react-query": "^5.108.2",
    "expo": "^58.0.26",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.32",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~5.9.3"
  }
}
