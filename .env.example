# Copy to .env (never commit .env). Server-only secrets.
# The mobile app must NEVER see AIVANA_API_KEY. Do not create EXPO_PUBLIC_* copies of it.

# Aivana API key (server only). Leave empty with AIVANA_MOCK=1 to build without spending credits.
AIVANA_API_KEY=

# 1 = return canned, schema-valid AI responses (no network, no credits). 0 = call the real API.
AIVANA_MOCK=1

# Aivana base URL (override only for testing)
AIVANA_BASE_URL=https://api.aivana.ai

# Server
PORT=3000
# Public base URL used in share links (e.g. https://falcon-travel.onrender.com). Defaults to http://localhost:PORT
PUBLIC_BASE_URL=
# SQLite file location (relative to apps/server)
DB_PATH=var/falcon.db

# Mobile (NOT secret — just where the server lives). Put this in apps/mobile/.env or your shell.
# Use your laptop LAN IP for Expo Go on a phone, or the Render / cloudflared HTTPS URL for TestFlight.
EXPO_PUBLIC_API_URL=http://localhost:3000
